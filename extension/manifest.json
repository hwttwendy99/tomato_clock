{
  "manifest_version": 3,
  "name": "TOMATO CLOCK",
  "version": "1.0.0",
  "description": "A pixel-art Pomodoro timer for focused learning and deep work.",
  "permissions": ["notifications", "storage", "alarms", "sidePanel"],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TOMATO CLOCK"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "offline_enabled": true
}
